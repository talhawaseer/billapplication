<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F3F6FA" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Consumer Management" android:textSize="24sp" android:textStyle="bold" android:textColor="#16324F"/>
    <EditText android:id="@+id/searchConsumers" style="@style/FormField" android:hint="Search name, common ID or reference"/>
    <CheckBox android:id="@+id/showArchived" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Include archived consumers"/>
    <Button android:id="@+id/addConsumer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ Add consumer" android:backgroundTint="#174A6E"/>
    <TextView android:id="@+id/consumerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Consumers" android:textColor="#64748B" android:paddingTop="8dp" android:paddingBottom="8dp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/consumerList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
</LinearLayout>
